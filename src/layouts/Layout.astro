---
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../styles/global.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  description?: string;
}

const {
  description = "Hey there, my name is Mayu, Welcome to my space! This is my portfolio website.",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>Ninefs</title>
    <link href="https://fonts.googleapis.com/css?family=Bangers" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/favicon.png" />
    <script>
      import "../scripts/tagFilter";
      import "../scripts/prideMode";
      import "../scripts/scrollTop";
      import "../scripts/imageSlider";
    </script>
  </head>
  <body>
    <div id="dot-background"></div>
    <Header />
    <slot />
    <BackToTop />
    <Footer />
  </body>
</html>
